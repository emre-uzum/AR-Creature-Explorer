<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_screen_bg">

    <LinearLayout
        android:id="@+id/inventoryHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/app_panel_dark_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/app_button_secondary_bg"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="Back"
            android:textAllCaps="false" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/inventoryTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Creature Storage"
                android:textColor="@color/app_text_light"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/inventorySubtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Your captured creatures"
                android:textColor="@color/app_text_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/inventoryStatusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:text="Loading captures..."
        android:textColor="@color/app_text_dark"
        android:textStyle="bold"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/inventoryHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/inventoryFilterRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/inventoryStatusText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/inventorySearchInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/app_input_light_bg"
            android:hint="Filter by creature name"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:paddingHorizontal="18dp"
            android:paddingVertical="14dp"
            android:textColor="@color/app_text_dark"
            android:textColorHint="@color/app_text_mid" />

        <AutoCompleteTextView
            android:id="@+id/inventoryTypeFilterInput"
            android:layout_width="126dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/app_input_light_bg"
            android:completionThreshold="0"
            android:dropDownHeight="wrap_content"
            android:focusable="false"
            android:hint="Type"
            android:imeOptions="actionDone"
            android:inputType="none"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:textColor="@color/app_text_dark"
            android:textColorHint="@color/app_text_mid" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/inventoryRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/inventoryFilterRow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/inventoryDetailOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/inventory_detail_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/inventoryDetailCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:background="@drawable/inventory_detail_card_bg"
            android:elevation="14dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="22dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/inventory_placeholder_bg">

                <ImageView
                    android:id="@+id/detailCreatureImageView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/detailPlaceholderInitialText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="?"
                    android:textColor="@android:color/white"
                    android:textSize="54sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/detailCreatureNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Creature Name"
                android:textColor="@color/app_text_dark"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailTypeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/app_chip_light_bg"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="Type"
                android:textColor="@color/app_text_dark"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailCaptureDateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Captured recently"
                android:textColor="@color/app_text_mid"
                android:textSize="14sp" />

            <Button
                android:id="@+id/closeDetailButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/app_button_primary_bg"
                android:minHeight="52dp"
                android:text="Close"
                android:textAllCaps="false"
                android:textColor="@color/app_mint_dark"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
