<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/arFragment"
        android:name="com.google.ar.sceneform.ux.ArFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Encounter overlay: initially hidden, shown once cube is placed -->
    <LinearLayout
        android:id="@+id/encounterPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_margin="16dp"
        android:background="@drawable/app_panel_dark_bg"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/encounterEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/app_chip_dark_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="AR Encounter"
            android:textAllCaps="true"
            android:textColor="@color/app_gold"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/encounterTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="A wild creature appeared!"
            android:textColor="@color/app_text_light"
            android:textStyle="bold"
            android:textSize="22sp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/encounterSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Move around to inspect it, then tap Capture."
            android:textColor="@color/app_text_muted"
            android:textSize="14sp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/creatureInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/app_chip_dark_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="Creature: -"
            android:textColor="@color/app_text_light"
            android:textSize="14sp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/tokenText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/app_chip_dark_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="Tokens: -"
            android:textColor="@color/app_text_light"
            android:textSize="14sp"
            android:paddingBottom="10dp" />

        <Button
            android:id="@+id/captureButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/app_button_primary_bg"
            android:minHeight="54dp"
            android:text="Capture" />

    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
