<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/app_chip_dark_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/outgoingRequestUsernameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Username"
        android:textColor="@color/app_text_light"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/outgoingRequestedAtText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Sent recently"
        android:textColor="@color/app_text_muted"
        android:textSize="13sp" />

    <Button
        android:id="@+id/cancelRequestButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/app_button_secondary_bg"
        android:minHeight="46dp"
        android:text="Cancel Request"
        android:textAllCaps="false" />

</LinearLayout>
