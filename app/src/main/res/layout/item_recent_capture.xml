<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/app_chip_dark_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/recentCaptureCreatureNameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Creature Name"
        android:textColor="@color/app_text_light"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/recentCaptureDateText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Captured recently"
        android:textColor="@color/app_text_muted"
        android:textSize="13sp" />

</LinearLayout>
